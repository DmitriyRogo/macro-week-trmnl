<div class="layout">
  <div class="mw">
    {% render "mw_next", next: next %}
    <div class="mw-panel">
      <span class="mw-kicker">Then</span>
      {%- for ev in upcoming offset: 1 limit: 5 -%}
        {%- render "mw_row", ev: ev -%}
      {%- endfor -%}
      {%- if upcoming.size < 2 -%}<span class="mw-note">Nothing else this week</span>{%- endif -%}
    </div>
    <div class="mw-panel">
      <span class="mw-kicker">Latest results</span>
      {%- for ev in latest limit: 4 -%}
        {%- render "mw_row", ev: ev -%}
      {%- endfor -%}
      {%- if latest.size == 0 -%}<span class="mw-note">No results yet this week</span>{%- endif -%}
    </div>
  </div>
</div>
{% render "mw_title", week_label: week_label, macro_ok: macro_ok %}
